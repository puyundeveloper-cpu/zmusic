{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    },
    "api/devices.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/play/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/artist/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/album/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/playlist/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/og-image.jpg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
