rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may read/write only their own profile document.
    // Device records are managed exclusively by the verified Vercel API using Admin SDK.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'lastLoginAt', 'createdAt',
          'provider', 'pushToken', 'pushUpdatedAt'
        ]);
      allow delete: if false;
      match /devices/{deviceId} {
        allow read, write: if false;
      }
      match /private/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
